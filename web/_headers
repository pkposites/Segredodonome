/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://connect.facebook.net https://*.clarity.ms; style-src 'self'; font-src 'self'; img-src 'self' data: https://www.facebook.com https://*.clarity.ms https://c.bing.com; connect-src 'self' https://segredodonome.robson-oc96.workers.dev https://www.facebook.com https://connect.facebook.net https://*.clarity.ms; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/js/*
  Cache-Control: public, max-age=300
/css/*
  Cache-Control: public, max-age=300

/fontes/*
  Cache-Control: public, max-age=31536000, immutable
