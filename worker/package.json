{
  "name": "segredo-do-nome-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validar-conteudo": "tsx scripts/validar-conteudo.ts",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:production": "wrangler deploy --env production",
    "gerar-painel": "node scripts/gerar-painel.mjs",
    "lint-genero": "python3 -I scripts/lint-genero.py ../content/nome",
    "migrar:local": "wrangler d1 migrations apply segredo-do-nome --local --env dev",
    "check": "npm run validar-conteudo && npm run typecheck && npm test"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
